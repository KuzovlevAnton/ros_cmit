<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">

  <xacro:macro name="solid_cuboid_inertial" params="mass x y z xyz='0 0 0' rpy='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia  ixx="${(mass/12.0) * (y*y + z*z)}" ixy = "0" ixz = "0"
                iyy="${(mass/12.0) * (x*x + z*z)}" iyz = "0"
                izz="${(mass/12.0) * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="solid_cylinder_inertial" params="mass radius length xyz='0 0 0' rpy='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia  ixx="${(mass/12.0) * (3*radius*radius + length*length)}" ixy="0" ixz="0"
                iyy="${(mass/12.0) * (3*radius*radius + length*length)}" iyz="0"
                izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="solid_sphere_inertial" params="mass radius xyz='0 0 0' rpy='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia  ixx="${(2.0/5.0) * mass * radius*radius}" ixy="0" ixz="0"
                iyy="${(2.0/5.0) * mass * radius*radius}" iyz="0"
                izz="${(2.0/5.0) * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="null_inertial">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </xacro:macro>

</robot>
